{
    "name": "oki-technologies/people-laravel",
    "description": "Sign people in with People, verify their tokens and keep their identities current — in Laravel, with a guard, a sync command and a test fake.",
    "keywords": [
        "laravel",
        "oauth2",
        "openid-connect",
        "oidc",
        "jwt",
        "identity"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/psr7": "^2.6",
        "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "oki-technologies/people-php": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Oki\\People\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oki\\People\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Oki\\People\\Laravel\\PeopleServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --coverage --min=100",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
